# Supabase (Project Settings → API). The service role key is SERVER-ONLY: never prefix it with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL used in emails and share links (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 32+ random chars. Signs QR tickets and private order links. Rotating it invalidates all issued QR codes.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
TICKET_SIGNING_SECRET=

# Comma-separated emails that become super admins after confirming their email
SUPER_ADMIN_EMAILS=

# Sandbox checkout (test mode, no real money). Set to false once a real provider is integrated.
PAYMENTS_SANDBOX=true
SANDBOX_WEBHOOK_SECRET=

# Transactional email via Resend (optional; emails are skipped until set)
RESEND_API_KEY=
EMAIL_FROM="AFTR <tickets@yourdomain.com>"
